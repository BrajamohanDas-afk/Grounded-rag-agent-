---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	contextualize(contextualize)
	route(route)
	chitchat(chitchat)
	plan(plan)
	retrieve(retrieve)
	grade(grade)
	rewrite(rewrite)
	generate(generate)
	verify(verify)
	finalize(finalize)
	abstain(abstain)
	__end__([<p>__end__</p>]):::last
	__start__ --> contextualize;
	contextualize --> route;
	generate --> verify;
	grade -.-> abstain;
	grade -.-> generate;
	grade -.-> rewrite;
	plan -.-> abstain;
	plan -.-> generate;
	plan -.-> retrieve;
	retrieve --> grade;
	rewrite -.-> abstain;
	rewrite -.-> generate;
	rewrite -.-> retrieve;
	route -.-> chitchat;
	route -.-> plan;
	verify -.-> finalize;
	verify -.-> generate;
	verify -.-> rewrite;
	abstain --> __end__;
	chitchat --> __end__;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

