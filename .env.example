
# ================= LLM =================
# Any provider supported by LangChain's init_chat_model: anthropic | openai | ollama | groq | google_genai ...
GRAG_LLM_PROVIDER=anthropic
GRAG_LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI:   GRAG_LLM_PROVIDER=openai  GRAG_LLM_MODEL=gpt-4o-mini   OPENAI_API_KEY=...
# Ollama:   GRAG_LLM_PROVIDER=ollama  GRAG_LLM_MODEL=llama3.1:8b   (free, local; `ollama pull llama3.1:8b`)

# ================= Embeddings =================
# huggingface (local, free) | openai | ollama | fake (tests only)
GRAG_EMBEDDING_PROVIDER=huggingface
GRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Ollama:  GRAG_EMBEDDING_PROVIDER=ollama   GRAG_EMBEDDING_MODEL=nomic-embed-text

# ================= Storage =================
GRAG_VECTOR_STORE=chroma          # chroma (persistent) | memory
GRAG_INDEX_DIR=./index

# ================= Pipeline knobs =================
GRAG_CHUNK_SIZE=800
GRAG_CHUNK_OVERLAP=120
GRAG_TOP_K=5
GRAG_BM25_WEIGHT=0.4
GRAG_USE_RERANKER=false
GRAG_MAX_RETRIEVAL_ROUNDS=2
GRAG_MAX_GENERATION_ATTEMPTS=2
GRAG_MIN_GROUNDING=0.99
GRAG_USE_JUDGE=true

# ================= Observability (optional, free tier) =================
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=grounded-rag
